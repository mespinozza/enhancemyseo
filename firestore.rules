rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // General rule for all collections
    match /{collection}/{document} {
      allow read, write, create, delete: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      allow create: if 
        request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Specific rules for important collections
    match /users/{userId} {
      // Allow read and write if the authenticated user's UID matches the document ID
      allow read, write, update: if request.auth != null && request.auth.uid == userId;
      
      // Allow user profile creation - critical fix for the permission error
      allow create: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.auth.uid == request.resource.data.uid;
      
      // Subscription lookup falls back to finding the user document by email when the
      // UID lookup misses (see checkUserSubscriptionStatus in lib/firebase/admin-users).
      // Scoped to the caller's own email so this permits `where('email','==',myEmail)`
      // without allowing anyone to enumerate other accounts.
      allow get, list: if request.auth != null && 
                          request.auth.token.email == resource.data.email;
    }
    
    // CRITICAL: Usage collection security rules
    match /usage/{usageId} {
      // Allow reads by the owning user (usage document ID format: {uid}_{month})
      // Check if the document ID starts with the user's UID followed by an underscore
      allow read: if request.auth != null && 
                     usageId.split('_')[0] == request.auth.uid;
      
      // Allow users to create and update their own usage documents (simplified for troubleshooting)
      allow create, update: if request.auth != null && 
                               usageId.split('_')[0] == request.auth.uid;
      
      // Never allow deletes from client
      allow delete: if false;
    }
    
    // Specific rules for user-owned collections.
    //
    // These deliberately do NOT carry `allow list: if request.auth != null`, which they
    // used to. That grants a query over the whole collection to any signed-in user, so it
    // let one account enumerate every other account's brand profiles — including their
    // Shopify access tokens. Expressing read in terms of resource.data.userId still allows
    // the owner-filtered queries the app actually makes, because Firestore accepts a query
    // whose constraints guarantee the rule passes.
    match /brandProfiles/{document} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
      
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      
      allow write, update, delete: if request.auth != null && 
                                      request.auth.uid == resource.data.userId;
    }
    
    match /blogs/{document} {
      // Public read access to published blogs, for crawlers and blog readers. This also
      // covers the public listing query, which filters on published == true.
      allow read: if resource.data.published == true;
      
      // Owners read their own blogs whether published or not.
      allow read: if request.auth != null && 
                  request.auth.uid == resource.data.userId;
                  
      allow write, create, delete: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Article editor revision snapshots. Subcollections do NOT inherit the /blogs rule
    // above, and there is no longer any catch-all, so this block is the only thing that
    // grants access to them.
    match /blogs/{blogId}/revisions/{revisionId} {
      allow read, list: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      
      // Snapshots are immutable; pruning old ones is a delete, never an edit.
      allow update: if false;
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.userId;
    }
    
    // Automation configuration, written from the browser by its owner.
    // Stating `read` in terms of resource.data.userId (rather than a blanket
    // `allow list: if request.auth != null`) lets an owner-filtered query through while
    // rejecting an unfiltered listing of every account's automations.
    match /automations/{automationId} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
      
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      
      allow update, delete: if request.auth != null && 
                               request.auth.uid == resource.data.userId;
    }
    
    // Run history is written only by the server through the Admin SDK, which bypasses
    // these rules. Clients read their own and never write.
    match /automationRuns/{runId} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
      
      allow create, update, delete: if false;
    }
    
    // Google Search Console refresh tokens. No client access of any kind: a refresh token
    // is long-lived credentials for the user's whole web property, and the browser never
    // needs it — /api/gsc/status reports connection state instead. The owner field in
    // these documents is named `ownerUid` rather than `userId` specifically so the generic
    // owner rule at the top of this file cannot match them either.
    match /gscConnections/{brandId} {
      allow read, list, create, update, delete: if false;
    }

    // Shopify store access tokens. Same reasoning as above and the same `ownerUid` field
    // naming: this token can read and write a merchant's entire catalogue and blog, and
    // the browser never needs it — /api/shopify/status reports connection state instead.
    match /shopifyConnections/{brandId} {
      allow read, list, create, update, delete: if false;
    }
    
    match /history/{document} {
      allow read, write, create, delete: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    match /generatedProducts/{document} {
      allow read, write, create, delete: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // There is deliberately NO `match /{path=**} { allow read, list: if request.auth != null; }`
    // fallback here. It used to exist, and because rules are a union it silently granted
    // every signed-in user read access to every document in the database — including
    // brandProfiles, which hold Shopify access tokens — and made every owner-scoped rule
    // above unenforceable. Every collection the app reads from the client now has an
    // explicit rule, so nothing needs a catch-all. Do not add one back; add a specific
    // match block instead.
    //
    // Known consequence: the diagnostic helpers in dashboard/history that probe arbitrary
    // collection paths ('articles', 'posts', 'generated-content', users/{uid}/blogs) now
    // get permission-denied instead of empty results. They are wrapped in try/catch and
    // only log, so this is noise in the console rather than broken behaviour.
  }
} 